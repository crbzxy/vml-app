# Copia a .env.local para pruebas locales.
# En Netlify → Site configuration → Environment variables.

RESEND_API_KEY=re_xxxxxxxx

# Dominio verificado en Resend (obligatorio para enviar a CONTACT_CC).
RESEND_FROM=Vortex Media Lab <noreply@vortexmedialab.mx>

# Destinatarios del lead (To = primero, Cc = resto).
CONTACT_CC=carofernandez@vortexmedialab.mx,luisfernandez@vortexmedialab.mx

# Copia oculta opcional (p. ej. tu Gmail personal).
CONTACT_BCC=carlos.boor@gmail.com

# Orígenes permitidos del form
CONTACT_ALLOWED_ORIGINS=https://vortexmedialab.mx,https://www.vortexmedialab.mx
