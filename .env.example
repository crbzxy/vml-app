# Copia a .env.local para pruebas locales. En Vercel → Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Vortex Media Lab <onboarding@resend.dev>

# Con onboarding@resend.dev SOLO llega a CONTACT_BCC (email de tu cuenta Resend).
CONTACT_BCC=carlos.boor@gmail.com

# Cuando verifiques vortexmedialab.mx y cambies RESEND_FROM a @vortexmedialab.mx,
# estos reciben en CC y CONTACT_BCC pasa a CCO.
CONTACT_CC=carofernandez@vortexmedialab.mx,luisfernandez@vortexmedialab.mx

# Orígenes permitidos del form (tu dominio + Vercel)
CONTACT_ALLOWED_ORIGINS=https://vortexmedialab.mx,https://www.vortexmedialab.mx,https://vml-app.vercel.app,https://vml-app-crbzxy.vercel.app
